//
// Grafana Faro Receiver
// Browser ---> Alloy
//


faro.receiver "frontend" {



    server {



        listen_address = "0.0.0.0"


        listen_port = 12347



        cors_allowed_origins = [

            "*",

        ]



    }






    output {



        logs = [


            loki.process.faro_logs.receiver,


        ]



    }



}









//
// Process Faro Logs
// Add labels before sending Loki
//


loki.process "faro_logs" {




    stage.static_labels {


        values = {


            app = "ecommerce-ui"


            source = "grafana-faro"


        }


    }







    forward_to = [


        loki.write.default.receiver,


    ]



}










//
// Send logs to Loki
//


loki.write "default" {



    endpoint {



        url = "http://loki:3100/loki/api/v1/push"



    }



}
