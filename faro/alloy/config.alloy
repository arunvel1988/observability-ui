faro.receiver "frontend" {


    server {

        listen_address = "0.0.0.0"

        listen_port = 12347


        cors_allowed_origins = [

            "*",

        ]

    }



    output {

        logs = [

            loki.process.faro_logs.receiver,

        ]

    }


}





loki.process "faro_logs" {



    stage.labels {

        values = {

            app = "app",

        }

    }



    forward_to = [

        loki.write.default.receiver,

    ]

}





loki.write "default" {



    endpoint {


        url = "http://loki:3100/loki/api/v1/push"


    }


}
