logging {
  level = "info"
}

loki.source.file "app_logs" {
  targets = [
    {
      __path__ = "/var/log/app.log",
    },
  ]

  forward_to = [
    loki.process.log_module.receiver,
  ]
}

loki.process "log_module" {

  stage.static_labels {
    values = {
      custom_module = "working",
      env           = "dev",
    }
  }

  forward_to = [
    loki.write.default.receiver,
  ]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
