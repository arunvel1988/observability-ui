logging {
  level = "info"
}

otelcol.receiver.otlp "app" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    metrics = [
      otelcol.processor.batch.default.input,
    ]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [
      prometheus.remote_write.mimir.receiver,
    ]
  }
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

loki.source.file "app_logs" {
  targets = [
    {
      __path__ = "/var/log/app.log",
    },
  ]

  forward_to = [
    loki.process.log_module.receiver,
  ]
}

loki.process "log_module" {
  stage.match {
    selector = "{}"
    regex    = "debug"
    action   = "drop"
  }

  stage.static_labels {
    values = {
      env  = "dev",
      team = "ecommerce",
    }
  }

  forward_to = [
    loki.write.default.receiver,
  ]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
