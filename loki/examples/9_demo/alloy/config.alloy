
local.file_match "app" {


 path_targets = [

  {

   "__path__" = "/logs/app.log",

  },

 ]

}




loki.source.file "logs" {


 targets = local.file_match.app.targets


 forward_to = [

  loki.process.parser.receiver,

 ]

}






loki.process "parser" {



 stage.json {


  expressions = {


   service = "service",


   event = "event",


   status = "status",


  }


 }



 stage.labels {


  values = {


   service = "",


   event = "",


   status = "",


  }


 }



 forward_to = [

  loki.write.default.receiver,

 ]


}






loki.write "default" {


 endpoint {


  url = "http://loki:3100/loki/api/v1/push"


 }


}


