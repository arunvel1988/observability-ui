otelcol.receiver.otlp "logs" {

  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    logs = [
      otelcol.processor.filter.security.input,
      otelcol.processor.filter.debug.input,
    ]
  }
}



otelcol.processor.filter "security" {

  error_mode = "ignore"

  logs {

    log_record = [
      "IsMatch(body, \"SECURITY\")",
    ]

  }


  output {

    logs = [
      otelcol.exporter.loki.security.input,
    ]

  }

}




otelcol.processor.filter "debug" {

  error_mode = "ignore"

  logs {

    log_record = [
      "not IsMatch(body, \"SECURITY\")",
    ]

  }


  output {

    logs = [
      otelcol.exporter.loki.debug.input,
    ]

  }

}




otelcol.exporter.loki "security" {

  forward_to = [
    loki.write.security.receiver,
  ]

}




otelcol.exporter.loki "debug" {

  forward_to = [
    loki.write.debug.receiver,
  ]

}




loki.write "security" {

  endpoint {

    url = "http://loki:3100/loki/api/v1/push"

    tenant_id = "security"

  }

}




loki.write "debug" {

  endpoint {

    url = "http://loki:3100/loki/api/v1/push"

    tenant_id = "debug"

  }

}