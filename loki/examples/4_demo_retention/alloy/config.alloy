local.file_match "docker_logs" {

  path_targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*.log",
    },
  ]
}



loki.source.file "containers" {

  targets = local.file_match.docker_logs.targets

  forward_to = [
    loki.process.parse.receiver,
  ]
}



loki.process "parse" {

  stage.docker {}

  forward_to = [
    loki.write.security.receiver,
  ]
}



loki.write "security" {

  endpoint {

    url = "http://loki:3100/loki/api/v1/push"

    headers = {
      "X-Scope-OrgID" = "security",
    }

  }

}