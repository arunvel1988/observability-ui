{
"title":"Ecommerce Custom Metrics Alloy",

"uid":"ecommerce-alloy",

"schemaVersion":39,

"refresh":"5s",

"panels":[


{
"title":"Orders Counter",

"type":"timeseries",

"targets":[

{
"expr":"orders_total"
}

],

"gridPos":{
"x":0,
"y":0,
"w":12,
"h":8
}

},



{
"title":"Active Cart Gauge",

"type":"gauge",

"targets":[

{
"expr":"active_carts"
}

],

"gridPos":{
"x":12,
"y":0,
"w":12,
"h":8
}

},



{
"title":"Checkout P95",

"type":"timeseries",

"targets":[

{
"expr":"histogram_quantile(0.95, rate(checkout_duration_seconds_bucket[5m]))"
}

],

"gridPos":{
"x":0,
"y":8,
"w":24,
"h":8
}

}


]

}
