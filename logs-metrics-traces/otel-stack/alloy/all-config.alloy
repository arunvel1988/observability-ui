
# ------------------------
# DOCKER LOGS
# ------------------------
local.file_match "docker_logs" {
  path_targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*.log",
      job      = "docker",
    },
  ]
}

loki.source.file "docker" {
  targets = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {

  stage.docker {}

  # Docker logs are JSON inside "log" field usually
  stage.json {
    expressions = {
      log = "log"
    }
  }

  stage.labels {
    values = {
      job = "docker"
    }
  }

  forward_to = [loki.write.default.receiver]
}


# ------------------------
# APP LOGS (your Flask JSON)
# ------------------------
local.file_match "app_logs" {
  path_targets = [
    {
      __path__ = "/app/logs/*.log",
      job      = "app",
    },
  ]
}

loki.source.file "app" {
  targets = local.file_match.app_logs.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {

  # STRICT JSON PARSING
  stage.json {
    expressions = {
      level   = "level",
      service = "service",
      message = "message",
    }
  }

  # DROP INVALID JSON
  stage.match {
    selector = ""

    stages = [
      stage.drop {
        expression = "level == \"\" or service == \"\" or message == \"\""
      }
    ]
  }

  stage.labels {
    values = {
      job     = "app",
      level   = "",
      service = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}


# ------------------------
# SECURITY LOGS (text-based, not JSON)
# ------------------------
local.file_match "security_logs" {
  path_targets = [
    {
      __path__ = "/security/logs/*.log",
      job      = "security",
    },
  ]
}

loki.source.file "security" {
  targets = local.file_match.security_logs.targets
  forward_to = [loki.process.security.receiver]
}

loki.process "security" {

  # NO JSON parsing here (important)

  stage.regex {
    expression = ".*user=.*action=.*"
  }

  stage.labels {
    values = {
      job = "security"
    }
  }

  forward_to = [loki.write.default.receiver]
}


# ------------------------
# LOKI OUTPUT
# ------------------------
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
